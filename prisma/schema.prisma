generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Operation {
  venta
  alquiler
  compartir
}

enum ListingStatus {
  activo
  oculto
  vendido
  alquilado
}

enum EnergyStatus {
  tiene
  tramite
  exento
}

enum PropertyType {
  Piso
  Atico
  Chalet
  Adosado
  Estudio
  Local
  Garaje
  Terreno
}

model Listing {
  id          String   @id @default(cuid())
  title       String?
  description String?  @db.Text

  // Ubicación
  address     String?
  city        String?
  province    String?
  zip         String?
  lat         Float?
  lng         Float?

  // Datos
  type        PropertyType?
  condition   String?
  price       Int
  priceHidden  Boolean? @default(false)
  communityFees Int?
  bedrooms    Int?
  bathrooms   Int?
  areaM2      Int?
  yearBuilt   Int?

  // Estado y visibilidad
  status      ListingStatus @default(activo)
  published   Boolean       @default(true)

  // Operación
  operation   Operation? @default(venta)

  // Extras
  extras      Json?

  // Multimedia
  coverUrl    String?
  images      Image[]

  // Energía
  energyStatus            EnergyStatus?
  /// @deprecated — campo heredado; ningún código nuevo lo escribe. Se mantiene solo para no perder datos hasta confirmar la migración.
  energyLabel             String?
  energyConsumption       Int?
  energyConsumptionLabel  String?   // letra A–G para consumo energético
  energyEmissions         Int?
  energyEmissionsLabel    String?   // letra A–G para emisiones de CO₂

  // Contacto
  reference     String?
  contactEmail  String?
  contactPhone  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([price])
  @@index([city])
  @@index([bedrooms])
  @@index([bathrooms])
  @@index([areaM2])
}

enum UserRole {
  superadmin
  admin
}

model User {
  id           String    @id @default(cuid())
  username     String?   @unique   // nullable for migration safety; always set in practice
  email        String?   @unique
  name         String?
  passwordHash String
  role         UserRole  @default(admin)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt @default(now())
}

model Image {
  id         String   @id @default(cuid())
  url        String
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model SiteContent {
  id        String   @id @default(cuid())
  section   String   @unique
  content   Json
  updatedAt DateTime @updatedAt
}


